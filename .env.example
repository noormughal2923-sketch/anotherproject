# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────
# Pooled connection string (used by Prisma at runtime)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/cgs?sslmode=require

# Direct (non-pooled) connection string (used by Prisma migrations)
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/cgs?sslmode=require

# ─── Google Sheets integration (service account) ───────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ─── Authentication ────────────────────────────────────────────────────
# Random secret used to sign admin session cookies (generate with: openssl rand -hex 32)
AUTH_SECRET=

# ─── Error monitoring (optional) ───────────────────────────────────────
SENTRY_DSN=

# ─── Cron job authentication (optional) ────────────────────────────────
# Used to authenticate Vercel Cron requests to /api/cron/sync
CRON_SECRET=

# ─── Seed-only values (used by `npm run seed`, never in production) ────
SEED_ADMIN_EMAIL=admin@cgs.local
SEED_ADMIN_PASSWORD=change-me-please